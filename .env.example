# Analytics (all optional — the first-party tracker works with none of these set)
# PostHog: product behaviour. Create/select the dossier project in PostHog, then set:
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# GA4: marketing acquisition. Admin > Data Streams > Web, then set:
NEXT_PUBLIC_GA_MEASUREMENT_ID=
